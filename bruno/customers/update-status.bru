meta {
  name: Atualizar Status do Cliente
  type: "http"
}

patch {
  url: {{baseUrl}}/customers/:id/status
  body: json
  auth: bearer
}

body:json {
  {
    "status": "INACTIVE"
  }
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  id: 1
}

docs {
  # Atualizar Status do Cliente
  Atualiza o status do cliente (ACTIVE ou INACTIVE). Requer role ADMIN.

  ## Exemplo de requisição
  ```json
  {
    "status": "INACTIVE"
  }
  ```

  ## Exemplo de resposta (200)
  ```json
  {
    "success": true,
    "message": "Status atualizado com sucesso.",
    "data": {
      "user": {
        "id": 5,
        "name": "Cliente Demo",
        "email": "cliente.demo@example.com",
        "role": "CUSTOMER",
        "status": "INACTIVE"
      },
      "customer": {
        "id": 3,
        "userId": 5,
        "zipCode": "01001-000",
        "street": "Praça da Sé",
        "number": "100",
        "complement": "Sala 1",
        "neighborhood": "Sé",
        "city": "São Paulo",
        "state": "SP",
        "createdAt": "2026-01-14T12:00:00Z",
        "updatedAt": "2026-01-14T12:00:00Z",
        "deletedAt": null
      }
    }
  }
  ```

  ## Status codes
  - 200 Sucesso
  - 400 Erro de validação
  - 401 Token inválido ou ausente
  - 403 Acesso negado (role não é ADMIN)
  - 404 Cliente não encontrado
  - 500 Erro interno
}

