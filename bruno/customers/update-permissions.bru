meta {
  name: Atualizar Permissões do Cliente
  type: "http"
}

patch {
  url: {{baseUrl}}/customers/:id/permissions
  body: json
  auth: bearer
}

body:json {
  {
    "modules": [
      {
        "module": "LOGS",
        "canView": true
      },
      {
        "module": "APPOINTMENTS",
        "canView": false
      }
    ]
  }
}

auth:bearer {
  token: {{token}}
}

vars:pre-request {
  id: 1
}

docs {
  # Atualizar Permissões do Cliente
  Atualiza permissões de acesso aos módulos para um cliente. Requer role ADMIN.

  ## Exemplo de requisição
  ```json
  {
    "modules": [
      {
        "module": "LOGS",
        "canView": true
      },
      {
        "module": "APPOINTMENTS",
        "canView": false
      }
    ]
  }
  ```

  ## Exemplo de resposta (200)
  ```json
  {
    "success": true,
    "message": "Permissões atualizadas com sucesso.",
    "data": {
      "permissions": [
        {
          "module": "LOGS",
          "canView": true
        },
        {
          "module": "APPOINTMENTS",
          "canView": false
        }
      ]
    }
  }
  ```

  ## Status codes
  - 200 Sucesso
  - 400 Erro de validação
  - 401 Token inválido ou ausente
  - 403 Acesso negado (role não é ADMIN)
  - 404 Cliente não encontrado
  - 500 Erro interno
}

