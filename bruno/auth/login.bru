meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "admin@bookings2.com",
    "password": "admin123",
    "isAdmin": true
  }
}

vars:pre-request {
  baseUrl: http:localhost:3001
}

tests {
  test("should login successfully", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("success", true);
    expect(body).to.have.property("data");
    expect(body.data).to.have.property("user");
    expect(body.data).to.have.property("token");
    bru.setVar("token", body.data.token);
    bru.setVar("userId", body.data.user.id);
  });
}

docs {
  # Login
  Autentica um usuário (administrador ou cliente) e retorna o token JWT para acessar endpoints protegidos.
  O campo `isAdmin` determina se o login é para um usuário ADMIN ou CUSTOMER.
  
  ## Exemplo de requisição (Admin)
  ```json
  {
    "email": "admin@example.com",
    "password": "senha-secreta",
    "isAdmin": true
  }
  ```
  
  ## Exemplo de requisição (Customer)
  ```json
  {
    "email": "customer@example.com",
    "password": "senha-secreta",
    "isAdmin": false
  }
  ```
  
  ## Exemplo de resposta (200)
  ```json
  {
    "success": true,
    "message": "Login realizado com sucesso.",
    "data": {
      "token": "eyJhbGciOi...",
      "user": {
        "id": 1,
        "name": "User Name",
        "email": "user@example.com",
        "role": "ADMIN"
      }
    }
  }
  ```
  
  ## Status codes
  - 200 Sucesso
  - 400 Erro de validação (email, password ou isAdmin inválidos)
  - 401 Credenciais inválidas ou role não corresponde ao isAdmin informado
  - 403 Usuário inativo
  - 500 Erro interno
}
