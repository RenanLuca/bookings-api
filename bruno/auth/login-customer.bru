meta {
  name: Login Customer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login/customer
  body: json
  auth: none
}

body:json {
  {
    "email": "customer@bookings.com",
    "password": "customer123"
  }
}

tests {
  test("should login customer successfully", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.have.property("success", true);
    expect(body).to.have.property("data");
    expect(body.data).to.have.property("user");
    expect(body.data).to.have.property("token");
    expect(body.data.user.role).to.equal("CUSTOMER");
    bru.setVar("token", body.data.token);
    bru.setVar("userId", body.data.user.id);
  });
}

docs {
  # Login Customer
  Autentica um usuário cliente e retorna o token JWT para acessar endpoints protegidos.
  Este endpoint aceita apenas usuários com role CUSTOMER.
  
  ## Exemplo de requisição
  ```json
  {
    "email": "customer@example.com",
    "password": "senha-secreta"
  }
  ```
  
  ## Exemplo de resposta (200)
  ```json
  {
    "success": true,
    "message": "Login realizado com sucesso.",
    "data": {
      "token": "eyJhbGciOi...",
      "user": {
        "id": 2,
        "name": "Customer",
        "email": "customer@example.com",
        "role": "CUSTOMER"
      }
    }
  }
  ```
  
  ## Status codes
  - 200 Sucesso
  - 400 Erro de validação
  - 401 Credenciais inválidas ou usuário não é customer
  - 403 Usuário inativo
  - 500 Erro interno
}
